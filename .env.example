# Required: Anthropic API key for Claude models (answer generation)
ANTHROPIC_API_KEY=sk-ant-...

# Required: ARLC platform API key (corpus download and submission)
EVAL_API_KEY=

# Optional: Google AI API key for speed agent (Gemini Flash Lite)
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_HOST=generativelanguage.googleapis.com

# LLM backend selection: litellm (default), vertex, anthropic, auto
# LLM_BACKEND=litellm

# --- Embedding backend ---
# RECOMMENDED: llama-server (Qwen3-Embedding-8B Q4_K_M via llama.cpp)
#   Requires llama-server running on port 8088. See neolex/embeddings/README.
#
#   Start server:
#     llama-server -m models/Qwen3-Embedding-8B-Q4_K_M.gguf \
#         --embedding --pooling last -ngl 99 -c 4096 --port 8088
#
# EMBEDDING_MODEL=llama-server
# LLAMA_SERVER_URL=http://localhost:8088
# LLAMA_MODEL_PATH=models/Qwen3-Embedding-8B-Q4_K_M.gguf
#
# Alternative: snowflake (default, no server needed, lower quality)
# EMBEDDING_MODEL=snowflake
# FAISS_INDEX_PATH=data/faiss_index.bin

# Optional: Vertex AI backend (direct AnthropicVertex client)
# VERTEX_PROJECT_ID=your-project
# VERTEX_LOCATION=us-east5
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Optional: LiteLLM proxy endpoints (round-robin load balancing)
# Supports up to 3 endpoints with suffixes: (none), _2, _3
# LITELLM_BASE_URL=https://your-proxy.example.com/v1
# LITELLM_API_KEY=sk-...
# LITELLM_MODEL_PREFIX=vertex_ai
# LITELLM_CUSTOMER_ID=your-id
#
# LITELLM_BASE_URL_2=https://your-proxy-2.example.com/v1
# LITELLM_API_KEY_2=sk-...
# LITELLM_MODEL_PREFIX_2=vertex_ai
